SECRET_KEY=your-secret-key-here
DEBUG=True

# Адреса, по которым открывают приложение. На Raspberry Pi укажите локальный IP
# в офисной сети и имя устройства в Tailscale, например:
# ALLOWED_HOSTS=192.168.1.50,lifteam.hvost-koshki.ts.net,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Адрес, который попадает в QR-коды этикеток. На Raspberry Pi по умолчанию
# это адрес в Tailscale — он одинаков и в офисе, и снаружи. Заполнять нужно,
# только если адрес другой или nginx не ставили (тогда с портом :8000).
# Пустое значение — брать адрес из того, как открыта страница печати.
# LABEL_BASE_URL=http://100.108.92.92

DATABASE_URL=

# Redis не нужен при запуске одного процесса Daphne (lifteam.settings_pi):
# используется InMemoryChannelLayer. Заполнять, только если процессов несколько.
REDIS_URL=

# Требуется для Docker/PostgreSQL (lifteam.settings_production)
POSTGRES_DB=lifteam
POSTGRES_USER=lifteam
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Включить, только когда перед приложением настроен TLS (Nginx/сертификат)
SECURE_SSL_REDIRECT=False

# Срок гарантии на ремонт в месяцах, от даты завершения заказа. 0 — не вести
WARRANTY_MONTHS=12

EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LiftTeam <noreply@example.com>

# Оповещения. Очередь наполняется всегда; эти параметры управляют отправкой.
# Главный выключатель — пока False, письма копятся и никуда не идут
NOTIFICATIONS_ENABLED=False
# Письма заказчикам о готовности и отгрузке заказа. Это переписка от лица
# фирмы с внешними людьми — включать осознанно
NOTIFY_CLIENTS=False
# Письма кладовщикам о деталях, ушедших в дефицит
NOTIFY_LOW_STOCK=True
# Не писать об одной детали чаще, чем раз в столько часов
NOTIFY_LOW_STOCK_COOLDOWN_HOURS=24

# Задолженности. Долг считается просроченным через столько дней после счёта
DEBT_OVERDUE_DAYS=14
# Сводка по должникам бухгалтеру и администратору — письмо внутреннее
NOTIFY_DEBT_DIGEST=True
DEBT_DIGEST_COOLDOWN_DAYS=7
# Напоминания об оплате самим заказчикам. Требуют ещё и NOTIFY_CLIENTS=True:
# это требование денег от лица фирмы, включать осознанно
NOTIFY_DEBTS=False
DEBT_REMINDER_COOLDOWN_DAYS=7

# Мессенджер MAX — второй канал для складских оповещений.
# Токен выдаёт @MasterBot по команде /create, порядок настройки — в DEPLOY.md.
# Пустой токен означает «канал не настроен»
MAX_BOT_TOKEN=
NOTIFY_MAX=False
# Общий чат вместо личных сообщений: оповещение уйдёт один раз в чат
MAX_GROUP_CHAT_ID=
# Адрес API. Менять только если MAX снова переедет (в 2026-м уже переезжал)
MAX_API_URL=https://platform-api2.max.ru

# Telegram — третий канал, устроен так же. Токен выдаёт @BotFather (/newbot).
# Проверьте, что с Pi Telegram вообще доступен: если нет, оповещения будут
# копиться в очереди с ошибкой
TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM=False
# Общая группа вместо личных сообщений (идентификатор группы отрицательный)
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org





# ---------------------------------------------------------------------------
# Банки, через которые выставляются счета
# ---------------------------------------------------------------------------
# Банков два, потому что бухгалтеров двое и работают они от разных юрлиц.
# Наборы секретов разные и намеренно не смешаны: токен одного банка
# в другом не работает. Какому юрлицу какой банк принадлежит — задаётся
# в программе, раздел «Реквизиты организации».
#
# Пустой токен означает «банк не настроен»: раздел просто не используется.

# --- Т-Банк ---
# Токен выдаётся в личном кабинете Т-Бизнеса (Настройки → Токены API).
# Для чтения выписки достаточно прав ТОЛЬКО на чтение: методов, двигающих
# деньги, в программе нет. Для выставления счетов нужно ещё право на них.
TBANK_TOKEN=
# Номер расчётного счёта для выписки. Узнать: python manage.py tbank_statement --accounts
TBANK_ACCOUNT=
TBANK_API_URL=https://business.tbank.ru/openapi
# Выставление счетов — отдельный выключатель. Читать выписку и слать
# заказчику счёт от лица фирмы — разные по последствиям действия
TBANK_INVOICE_ENABLED=False
# С какого номера начинать, если программа ещё не видела ни одного счёта.
# Ряд номеров один на всю программу и при двух юрлицах
TBANK_INVOICE_NUMBER_START=1
TBANK_INVOICE_DUE_DAYS=14
TBANK_INVOICE_UNIT=шт.
TBANK_INVOICE_VAT=None
# За сколько последних дней тянуть выписку при каждом запуске
TBANK_STATEMENT_DAYS=30

# --- Точка Банк ---
# Точка предлагает два способа входа: JWT-токен и OAuth 2.0. Нужен JWT:
# OAuth предназначен для сервисов, обслуживающих ЧУЖИХ клиентов банка,
# а мы выставляем счета за себя. Токен выпускается в личном кабинете.
TOCHKA_TOKEN=
# Код клиента и идентификатор счёта. Оба узнаются у самого банка методами
# «список клиентов» и «список счетов». accountId — это номер счёта и БИК,
# а не просто номер счёта
TOCHKA_CUSTOMER_CODE=
TOCHKA_ACCOUNT_ID=
TOCHKA_API_URL=https://enter.tochka.com/uapi
TOCHKA_API_VERSION=v1.0
# Свой выключатель, как и у Т-Банка
TOCHKA_INVOICE_ENABLED=False
TOCHKA_INVOICE_DUE_DAYS=14
TOCHKA_INVOICE_UNIT=шт.
# Названия ставок НДС у Точки свои: without_nds, nds_0, nds_5, nds_7,
# nds_10, nds_20. without_nds — без НДС, на УСН это и нужно
TOCHKA_INVOICE_NDS=without_nds
# Суммы числом или строкой. По описанию API банка — числом, так и стоит.
# Если банк откажет по сумме, поставьте True: это единственное, что
# в таком случае надо поменять
TOCHKA_INVOICE_AMOUNTS_AS_STRING=False
