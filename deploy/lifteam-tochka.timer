# Когда тикать за выпиской Точки.
#
# Таймер **только тикает** — раз в четверть часа в рабочее время буднего
# дня, тот же приём, что у lifteam-tbank.timer. Тянуть ли выписку на этом
# тике, решает сама программа по настройке «Тянуть выписку раз в, минут»
# (по умолчанию час) — юнит правится от root, а частоту владелец меняет
# со страницы «Настройки».
#
# Выписка у Точки готовится не сразу (Created → Processing → Ready),
# поэтому команда на каждом тике сама ждёт готовности несколько попыток
# подряд, а не дождавшись — откладывает ту же заявку до следующего тика,
# не заказывая новую.
#
# Ночь и выходные пропущены намеренно: разносить поступления в это время
# всё равно некому, а лишние обращения к банку — лишний повод получить
# ограничение по частоте запросов.

[Unit]
Description=Тик загрузки выписки Точки для LiftTeam

[Timer]
OnCalendar=Mon..Fri 08..19:00/15
# Разброс до двух минут: чтобы запрос к банку не приходился ровно
# на ту же секунду, что и остальные задачи по расписанию (включая тик
# Т-Банка)
RandomizedDelaySec=2min

# Если Pi был выключен, выписка подтянется после включения. Пропущенные
# дни не теряются: команда всегда берёт последние TOCHKA_STATEMENT_DAYS дней
Persistent=true

[Install]
WantedBy=timers.target
