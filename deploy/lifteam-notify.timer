# Как часто разбирать очередь оповещений.
#
# Пять минут: письмо о готовности заказа не срочное, а более частый запуск
# означал бы лишние подключения к почтовому серверу впустую — очередь чаще
# всего пуста.

[Unit]
Description=Регулярная отправка оповещений LiftTeam

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min

# Если Pi был выключен, очередь разберётся после включения
Persistent=true

[Install]
WantedBy=timers.target
