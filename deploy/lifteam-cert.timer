# Раз в неделю проверять сертификат Tailscale.
#
# Чаще незачем: сертификат живёт около трёх месяцев, а команда при живом
# сертификате не делает ничего. Реже опасно: пропустить одно окно
# обновления из-за выключенной Pi — обычное дело, и запас должен быть.

[Unit]
Description=Еженедельное обновление сертификата Tailscale для LiftTeam

[Timer]
OnCalendar=Mon 04:30
# Pi выключали — обновление должно пройти при следующем включении,
# а не ждать понедельника
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
