# Расписание резервного копирования: ежедневно ночью.

[Unit]
Description=Ежедневное резервное копирование базы LiftTeam

[Timer]
OnCalendar=*-*-* 03:30:00

# Если Pi был выключен в назначенное время, копия снимется после включения,
# а не будет пропущена до следующих суток
Persistent=true

# Разброс до 5 минут, чтобы копирование не начиналось секунда в секунду
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
