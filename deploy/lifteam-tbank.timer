# Когда тикать за выпиской Т-Банка.
#
# Таймер **только тикает** — раз в четверть часа в рабочее время буднего
# дня. Тянуть ли выписку на этом тике, решает сама программа
# по настройке «Тянуть выписку раз в, минут» (по умолчанию час).
#
# Разделено так потому, что этот файл правится от root, а частоту владелец
# меняет со страницы «Настройки». Расписание в юните он бы не поправил,
# а частоту менять хочется — платежи у разных заказчиков идут по-разному.
#
# Ночь и выходные пропущены намеренно: разносить поступления в это время
# всё равно некому, а лишние обращения к банку — лишний повод получить
# ограничение по частоте запросов.

[Unit]
Description=Тик загрузки выписки Т-Банка для LiftTeam

[Timer]
OnCalendar=Mon..Fri 08..19:00/15
# Разброс до двух минут: чтобы запрос к банку не приходился ровно
# на ту же секунду, что и остальные задачи по расписанию
RandomizedDelaySec=2min

# Если Pi был выключен, выписка подтянется после включения. Пропущенные
# дни не теряются: команда всегда берёт последние TBANK_STATEMENT_DAYS дней
Persistent=true

[Install]
WantedBy=timers.target
