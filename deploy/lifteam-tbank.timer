# Когда тянуть выписку из Т-Банка.
#
# Раз в час в рабочее время буднего дня. Чаще незачем: платежи между
# юридическими лицами идут рейсами, а не мгновенно, и раньше следующего
# рейса новых поступлений всё равно не будет.
#
# Ночь и выходные пропущены намеренно: разносить поступления в это время
# всё равно некому, а лишние обращения к банку — лишний повод получить
# ограничение по частоте запросов.

[Unit]
Description=Ежечасная загрузка выписки Т-Банка для LiftTeam

[Timer]
OnCalendar=Mon..Fri 08..19:05
# Разброс до трёх минут: чтобы запрос к банку не приходился ровно
# на ту же секунду, что и остальные задачи по расписанию
RandomizedDelaySec=3min

# Если Pi был выключен, выписка подтянется после включения. Пропущенные
# дни не теряются: команда всегда берёт последние TBANK_STATEMENT_DAYS дней
Persistent=true

[Install]
WantedBy=timers.target
