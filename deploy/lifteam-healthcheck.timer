# Как часто проверять доступность приложения.
#
# Пять минут — компромисс: сотрудник вряд ли успеет заметить сбой и позвонить,
# но и лишней нагрузки на Pi не создаётся.

[Unit]
Description=Периодическая проверка доступности LiftTeam

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min

# Разброс, чтобы проверка не совпадала с другими задачами по расписанию
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
