# Когда проверять зависшие заказы.
#
# Раз в сутки: проверка идёт по времени с последнего движения заказа,
# считанного в днях, — чаще запускать незачем. Каждый день, включая
# выходные: это внутреннее оповещение персоналу, а не письмо заказчику,
# и раздражать в выходной некого.

[Unit]
Description=Ежедневная проверка просроченных заказов LiftTeam

[Timer]
OnCalendar=*-*-* 09:15
# Разброс до пяти минут: чтобы проверка не стартовала ровно в ту же
# секунду, что и остальные утренние задачи
RandomizedDelaySec=5min

# Если Pi был выключен в момент запуска, проверка пройдёт после включения
Persistent=true

[Install]
WantedBy=timers.target
