# Когда проверять задолженности.
#
# Раз в сутки утром в рабочий день: сводка нужна к началу дня, а долги
# за ночь не появляются. Чаще незачем — и сводка, и напоминание по одному
# заказу всё равно повторяются не чаще паузы из настроек.
#
# Суббота и воскресенье пропущены намеренно: письмо о деньгах, пришедшее
# заказчику в выходной, раздражает и ничего не ускоряет.

[Unit]
Description=Ежедневная проверка задолженностей LiftTeam

[Timer]
OnCalendar=Mon..Fri 09:00
# Разброс до пяти минут: чтобы проверка не стартовала ровно в ту же
# секунду, что и остальные утренние задачи
RandomizedDelaySec=5min

# Если Pi был выключен в девять утра, проверка пройдёт после включения
Persistent=true

[Install]
WantedBy=timers.target
