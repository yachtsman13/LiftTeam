# Следит за появлением заявки на обновление из веб-интерфейса.
#
# Такой способ выбран, чтобы приложению не понадобился sudo: оно просто
# создаёт файл, а привилегированную работу выполняет отдельная служба.
#
# Установка:
#   sudo cp deploy/lifteam-update.{path,service} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lifteam-update.path

[Unit]
Description=Ожидание заявки на обновление LiftTeam

[Path]
PathExists=/opt/lifteam/.update-request
Unit=lifteam-update.service

[Install]
WantedBy=multi-user.target
