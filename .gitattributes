# Git attributes for LiftTeam
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf

