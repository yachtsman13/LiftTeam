# Git attributes for LiftTeam
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf

# Файлы развёртывания исполняются только на Linux. CRLF здесь ломает systemd:
# возврат каретки попадает в конец пути в ExecStart, и сервис не стартует.
deploy/** text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf

# Бинарные файлы — git не должен трогать в них переводы строк
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary




